{
  "name": "shutteros-playground",
  "version": "0.3.1",
  "private": true,
  "description": "ShutterOS Playground \u2014 an independent cybersecurity awareness game for European Cybersecurity Month",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/prepare-branding.mjs && vite dev --host 127.0.0.1",
    "build": "node scripts/prepare-branding.mjs && node scripts/prepare-portable-configuration.mjs && vite build && vite build --config vite.portable.config.ts && node scripts/package-notices.mjs",
    "notices:update": "node scripts/package-notices.mjs --update-source",
    "preview": "vite preview --host 127.0.0.1",
    "check:core": "tsc -p packages/core/tsconfig.json",
    "check": "node scripts/prepare-branding.mjs && node scripts/prepare-portable-configuration.mjs && tsc -p packages/core/tsconfig.json && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "knip": "node scripts/prepare-branding.mjs && node scripts/prepare-portable-configuration.mjs && knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "node scripts/prepare-branding.mjs && storybook dev -p 6006 --no-open --disable-telemetry",
    "build:storybook": "node scripts/prepare-branding.mjs && storybook build --disable-telemetry",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm knip && pnpm test && pnpm build && pnpm test:e2e",
    "changeset": "changeset",
    "release": "node scripts/start-release.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:push": "node scripts/release.mjs push",
    "build:site": "node scripts/build-site.mjs",
    "docs:api": "typedoc",
    "test:site": "playwright test --config playwright.site.config.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^1.44.0",
    "@shutteros/core": "workspace:*",
    "bits-ui": "2.19.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-svelte-csf": "^5.0.0",
    "@storybook/sveltekit": "10.6.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^17.12.0",
    "knip": "6.35.1",
    "marked": "^18.0.13",
    "parse5": "^8.0.1",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "storybook": "10.6.0",
    "svelte": "5.57.0",
    "svelte-check": "^4.4.0",
    "tailwindcss": "4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "5.0.0"
  },
  "author": {
    "name": "F. Cabouat"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fcabouat/shutteros-playground.git"
  }
}
